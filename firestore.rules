rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /readerHighlights/{highlightId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorId
        && request.resource.data.keys().hasAll([
          'authorId', 'quote', 'title', 'category', 'section',
          'url', 'articlePath', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'authorId', 'quote', 'title', 'category', 'section',
          'url', 'articlePath', 'createdAt'
        ])
        && request.resource.data.authorId is string
        && request.resource.data.quote is string
        && request.resource.data.quote.size() >= 2
        && request.resource.data.quote.size() <= 2000
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100
        && request.resource.data.section is string
        && request.resource.data.section.size() <= 500
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 1200
        && request.resource.data.url.matches('^https://zluckyhou[.]github[.]io/.*$')
        && request.resource.data.articlePath is string
        && request.resource.data.articlePath.size() <= 500
        && request.resource.data.articlePath.matches('^/(blog|ai-daily)/.*$')
        && request.resource.data.createdAt == request.time;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      allow update: if false;
    }
  }
}
